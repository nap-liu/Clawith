+    def interrupt_and_wait(self, msg_id: str, timeout: float = 2.0) -> bool:
+        """Interrupt the active cell and wait briefly for this execution to idle."""
+        try:
+            self.kernel_manager.interrupt_kernel()
+        except Exception as e:
+            logger.warning(
+                f'Failed to interrupt kernel session {self.session_id}: {e}'
+            )
+            return False
+
+        deadline = time.monotonic() + timeout
+        while True:
+            remaining = deadline - time.monotonic()
+            if remaining <= 0:
+                return False
+            try:
+                msg = self.kernel_client.get_iopub_msg(timeout=remaining)
+            except Exception:
+                return False
+            if (
+                msg.get('parent_header', {}).get('msg_id') == msg_id
+                and msg.get('msg_type') == 'status'
+                and msg.get('content', {}).get('execution_state') == 'idle'
+            ):
+                return True
+
     def cleanup(self):
         try:
             self.kernel_client.stop_channels()
